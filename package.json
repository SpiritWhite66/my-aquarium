{
  "name": "my-aquarium",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "ai": "node scripts/build-ai.mjs",
    "catalog:export": "node scripts/export-catalog.mjs",
    "prestart": "npm run shared:build && npm run ai",
    "start": "ng serve",
    "prebuild": "npm run shared:build && npm run ai",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "mutation": "stryker run",
    "server:mutation": "npm run mutation -w api",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\" \"*.{ts,mjs,mts,json}\" \"api/**/*.{ts,json}\" \"shared/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\" \"*.{ts,mjs,mts,json}\" \"api/**/*.{ts,json}\" \"shared/**/*.{ts,json}\"",
    "knip": "knip",
    "e2e": "playwright test",
    "server:build": "tsc -b api/tsconfig.build.json",
    "server:test": "npm run test -w shared -w api",
    "shared:build": "npm run build -w shared",
    "pretest": "npm run shared:build",
    "prelint": "npm run shared:build"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@angular/service-worker": "^22.2.5",
    "@fontsource/figtree": "^5.3.0",
    "dexie": "^4.4.7",
    "fflate": "^0.8.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@axe-core/playwright": "^4.14.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "eslint-plugin-security": "^4.2.1",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^31.0.0",
    "knip": "^6.44.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "workspaces": [
    "shared",
    "api"
  ]
}
