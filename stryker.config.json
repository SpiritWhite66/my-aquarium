{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.mutation.config.mts"
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/app/core/*.ts",
    "!src/app/core/*.spec.ts",
    "!src/app/core/*.testing.ts",
    "!src/app/core/models.ts",
    "!src/app/core/catalog.ts",
    "!src/app/core/db.ts",
    "!src/app/core/theme.ts",
    "!src/app/core/clock.ts",
    "!src/app/core/backup.ts",
    "src/app/core/data/*.repo.ts"
  ],
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "ignoreStatic": true,
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": 75
  },
  "timeoutMS": 20000
}
