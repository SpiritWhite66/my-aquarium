{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.mutation.config.mts"
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/app/core/store.ts",
    "src/app/core/notifications.ts",
    "src/app/core/photos.ts",
    "src/app/core/data/{care,gear,livestock,photo,tank,backup,prefs}.repo.ts"
  ],
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "ignoreStatic": true,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "timeoutMS": 20000
}